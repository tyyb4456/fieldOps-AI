# Application
APP_NAME=FieldOps AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://fieldops:fieldops@localhost:5432/fieldops
# Production example: append ?ssl=verify-full to require TLS
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
DB_ECHO=false
# Production only: require TLS in DATABASE_URL (ssl=require/verify-ca/verify-full)
DB_REQUIRE_TLS=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Private document storage (local filesystem driver for Step 4.4)
# Relative paths are resolved against the backend directory.
STORAGE_BACKEND=local
STORAGE_ROOT=var/document_storage
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_DOCUMENT_CONTENT_TYPES=application/pdf
MAX_PDF_PAGES=500
DOCUMENT_CHUNK_SIZE=1000
DOCUMENT_CHUNK_OVERLAP=200
DOCUMENT_INGESTION_VERSION=1

# Google Gemini embeddings and pgvector retrieval (Step 4.5.1)
# Required in production. When unset in development, ingestion and knowledge
# search that need embeddings return 503 instead of starting without a provider.
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
# Fixed at 1536 for the current pgvector schema. Changing it requires a matching
# vector-column migration.
EMBEDDING_DIMENSIONS=1536
RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=20

# OpenAI chat model for grounded knowledge answers (Step 4.5.2)
# Required in production. When unset in development, answer generation returns
# 503 instead of starting without a provider. Retrieval-only requests that find
# no evidence still return an insufficient-evidence response.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
CHAT_TEMPERATURE=0.0
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_RETRIES=0
CHAT_MAX_OUTPUT_TOKENS=1024
ANSWER_MIN_SIMILARITY=0.3
ANSWER_MAX_CONTEXT_CHARS=16000

# Clerk authentication (backend only). Never expose these values to the browser.
# Required in production unless CLERK_JWT_KEY is provided.
CLERK_SECRET_KEY=
# Optional PEM public key for networkless token verification. When set, the
# backend verifies session tokens without calling Clerk's Backend API for JWKS.
CLERK_JWT_KEY=
# Comma-separated frontend origins allowed to mint Clerk session tokens.
# Must match the frontend application origins.
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Best-effort in-process limits for POST /api/v1/auth/bootstrap. Multi-instance
# deployments must also enforce limits at the reverse proxy or gateway.
AUTH_BOOTSTRAP_RATE_LIMIT_PER_IP=30
AUTH_BOOTSTRAP_RATE_LIMIT_PER_SUBJECT=10
AUTH_BOOTSTRAP_RATE_LIMIT_WINDOW_SECONDS=60
