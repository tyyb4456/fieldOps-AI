# Application
APP_NAME=FieldOps AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# PostgreSQL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://fieldops:fieldops@localhost:5432/fieldops
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_TIMEOUT=5
DB_ECHO=false

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
